#!/usr/bin/env python3
"""agentmux-progress — report long-job progress to AgentMux, non-intrusively.

Two modes:

  agentmux-progress [--label L] [--id KEY] -- <cmd> [args...]
      Run <cmd> unchanged and stream its output through byte-for-byte (the child
      runs under a pty, so tqdm/rich progress bars behave exactly as if attached
      to the terminal). A copy of the output is parsed for progress and written
      to a side JSON file. The child's exit code is preserved; SIGINT/SIGTERM and
      window-size changes are forwarded. Anything that goes wrong on the progress
      side is swallowed, so the job itself is never affected.

  agentmux-progress report [--current N] [--total M] [--percent P] [--msg S]
                           [--state running|done|failed] [--id KEY] [--label L]
      Write/update the progress file explicitly (for jobs whose output can't be
      auto-parsed). Prints nothing, touches nothing else.

The file is written to  $AGENTMUX_PROGRESS_DIR  (default ~/.agentmux/progress),
named by the tmux pane it runs in ($TMUX_PANE) or by --id. AgentMux reads it over
its normal read-only refresh and shows it in the right sidebar. Writing it never
touches the project directory or the job's own files.
"""
import json
import os
import re
import signal
import sys
import time

SCHEMA = 1
MIN_WRITE_INTERVAL = 1.0  # seconds; throttle sidecar writes


def progress_path(key):
    base = os.environ.get("AGENTMUX_PROGRESS_DIR") or os.path.join(
        os.path.expanduser("~"), ".agentmux", "progress"
    )
    safe = re.sub(r"[^A-Za-z0-9._%-]", "_", key) or "default"
    return os.path.join(base, safe + ".json")


def default_key(explicit):
    if explicit:
        return explicit
    return os.environ.get("TMUX_PANE") or "default"


def atomic_write(path, obj):
    """Write JSON atomically; never raise (progress must not affect the job)."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = "%s.tmp.%d" % (path, os.getpid())
        with open(tmp, "w") as f:
            json.dump(obj, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except Exception:
        pass


# --- progress parsing -------------------------------------------------------

_PCT = re.compile(r"(\d{1,3}(?:\.\d+)?)\s*%")
_FRAC = re.compile(r"(?<![\d./])(\d+)\s*/\s*(\d+)(?![\d/])")
_EPOCH = re.compile(r"(?:epoch|step|iter|batch)\s*[:#]?\s*(\d+)\s*/\s*(\d+)", re.I)
# tqdm bracket: [elapsed<remaining, rate]  e.g. [00:12<01:40, 2.3it/s]
_TQDM_ETA = re.compile(r"\[(\d+:\d+(?::\d+)?)<(\d+:\d+(?::\d+)?)")
_ETA_WORD = re.compile(r"\beta[:\s]+(\d+:\d+(?::\d+)?)", re.I)


def _hms_to_s(text):
    parts = [int(p) for p in text.split(":")]
    s = 0
    for p in parts:
        s = s * 60 + p
    return s


def parse_progress(segment):
    """Extract a progress dict from one output segment, or None."""
    out = {}
    m = _EPOCH.search(segment) or _FRAC.search(segment)
    if m:
        cur, tot = int(m.group(1)), int(m.group(2))
        if tot > 0 and cur <= tot:
            out["current"], out["total"] = cur, tot
    m = _PCT.search(segment)
    if m:
        try:
            p = float(m.group(1))
            if 0 <= p <= 100:
                out["percent"] = p
        except ValueError:
            pass
    m = _TQDM_ETA.search(segment)
    if m:
        out["eta_seconds"] = _hms_to_s(m.group(2))
    else:
        m = _ETA_WORD.search(segment)
        if m:
            out["eta_seconds"] = _hms_to_s(m.group(1))
    if not out:
        return None
    msg = segment.strip()
    if msg:
        out["message"] = msg[-200:]
    return out


class Reporter:
    def __init__(self, key, label):
        self.path = progress_path(key)
        self.started = time.time()
        self.last_write = 0.0
        self.state = {
            "schema": SCHEMA,
            "label": label,
            "state": "running",
            "started_at": self.started,
        }
        # Associate this job with the tmux pane it runs in, so AgentMux can show
        # it under the right agent regardless of the file key (--id).
        pane = os.environ.get("TMUX_PANE")
        if pane:
            self.state["pane"] = pane
        self._flush(force=True)

    def update(self, fields, force=False):
        self.state.update(fields)
        now = time.time()
        if not force and now - self.last_write < MIN_WRITE_INTERVAL:
            return
        self._flush()

    def _flush(self, force=False):
        self.last_write = time.time()
        self.state["updated_at"] = self.last_write
        # Estimate ETA from rate when the job gives a total but no ETA.
        st = self.state
        if "eta_seconds" not in st and st.get("total") and st.get("current"):
            cur, tot = st["current"], st["total"]
            elapsed = self.last_write - self.started
            if 0 < cur < tot and elapsed > 0:
                st["eta_seconds"] = int(elapsed / cur * (tot - cur))
        atomic_write(self.path, st)

    def finish(self, state, code=None):
        self.state["state"] = state
        self.state.pop("eta_seconds", None)
        if code is not None:
            self.state["exit_code"] = code
        self._flush(force=True)


# --- report mode ------------------------------------------------------------

def mode_report(argv):
    import argparse

    p = argparse.ArgumentParser(prog="agentmux-progress report", add_help=True)
    p.add_argument("--current", type=int)
    p.add_argument("--total", type=int)
    p.add_argument("--percent", type=float)
    p.add_argument("--msg", "--message", dest="msg")
    p.add_argument("--state", choices=["running", "done", "failed"], default="running")
    p.add_argument("--eta", type=int, help="ETA in seconds")
    p.add_argument("--id")
    p.add_argument("--label")
    args = p.parse_args(argv)

    path = progress_path(default_key(args.id))
    # Merge onto any existing file so started_at and label persist.
    try:
        with open(path) as f:
            st = json.load(f)
    except Exception:
        st = {"schema": SCHEMA, "started_at": time.time()}
    if args.label:
        st["label"] = args.label
    st.setdefault("label", "job")
    for k, v in (
        ("current", args.current), ("total", args.total),
        ("percent", args.percent), ("message", args.msg), ("eta_seconds", args.eta),
    ):
        if v is not None:
            st[k] = v
    st["state"] = args.state
    st["updated_at"] = time.time()
    pane = os.environ.get("TMUX_PANE")
    if pane:
        st["pane"] = pane
    if args.state != "running":
        st.pop("eta_seconds", None)
    atomic_write(path, st)
    return 0


# --- run mode (pty passthrough) --------------------------------------------

def mode_run(cmd, label, key):
    import fcntl
    import pty
    import struct
    import termios

    if not label:
        label = os.path.basename(cmd[0])

    reporter = None
    try:
        reporter = Reporter(default_key(key), label)
    except Exception:
        reporter = None

    pid, fd = pty.fork()
    if pid == 0:
        # Child: exec the real command, unchanged.
        try:
            os.execvp(cmd[0], cmd)
        except Exception as e:
            sys.stderr.write("agentmux-progress: cannot run %s: %s\n" % (cmd[0], e))
            os._exit(127)

    # Parent: copy pty <-> our stdio, parse a copy of the child's output.
    def set_winsize():
        try:
            sz = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(fd, termios.TIOCSWINSZ, sz)
        except Exception:
            pass

    set_winsize()
    try:
        signal.signal(signal.SIGWINCH, lambda *_: set_winsize())
    except Exception:
        pass
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(s, lambda sig, _f: os.kill(pid, sig))
        except Exception:
            pass

    import select

    buf = b""
    out_fd = sys.stdout.fileno()
    in_fd = sys.stdin.fileno()
    stdin_ok = True
    try:
        stdin_ok = os.isatty(in_fd) or not sys.stdin.closed
    except Exception:
        stdin_ok = False

    while True:
        try:
            rfds = [fd] + ([in_fd] if stdin_ok else [])
            r, _, _ = select.select(rfds, [], [], 0.2)
        except (InterruptedError, OSError):
            continue
        if fd in r:
            try:
                data = os.read(fd, 65536)
            except OSError:
                data = b""
            if not data:
                break
            # Passthrough, unchanged.
            try:
                os.write(out_fd, data)
            except OSError:
                pass
            # Parse a copy for progress. Split on \r and \n so tqdm's in-place
            # updates are each seen as their own segment.
            if reporter is not None:
                try:
                    buf += data
                    buf = buf[-8192:]
                    text = buf.decode("utf-8", "replace")
                    segments = re.split(r"[\r\n]", text)
                    for seg in reversed(segments):
                        fields = parse_progress(seg)
                        if fields:
                            reporter.update(fields)
                            break
                except Exception:
                    pass
        if stdin_ok and in_fd in r:
            try:
                data = os.read(in_fd, 65536)
                if data:
                    os.write(fd, data)
                else:
                    stdin_ok = False
            except OSError:
                stdin_ok = False

    _, status = os.waitpid(pid, 0)
    if os.WIFSIGNALED(status):
        code = 128 + os.WTERMSIG(status)
    else:
        code = os.WEXITSTATUS(status)
    if reporter is not None:
        try:
            reporter.finish("done" if code == 0 else "failed", code)
        except Exception:
            pass
    return code


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "report":
        return mode_report(argv[1:])

    label = None
    key = None
    rest = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            rest = argv[i + 1:]
            break
        elif a == "--label":
            i += 1
            label = argv[i] if i < len(argv) else None
        elif a == "--id":
            i += 1
            key = argv[i] if i < len(argv) else None
        elif a in ("-h", "--help"):
            sys.stdout.write(__doc__)
            return 0
        else:
            # First bare token begins the command (allow omitting --).
            rest = argv[i:]
            break
        i += 1

    if not rest:
        sys.stderr.write("usage: agentmux-progress [--label L] [--id KEY] -- <cmd...>\n")
        return 2
    return mode_run(rest, label, key)


if __name__ == "__main__":
    sys.exit(main())
