diff --git a/Sources/GhosttyHostEnvironment/environment.c b/Sources/GhosttyHostEnvironment/environment.c
new file mode 100644
index 0000000..9b1a1f2
--- /dev/null
+++ b/Sources/GhosttyHostEnvironment/environment.c
@@ -0,0 +1,32 @@
+#include "GhosttyHostEnvironment.h"
+
+#include <crt_externs.h>
+#include <stdlib.h>
+#include <string.h>
+
+bool ghostty_host_detach_environment(void) {
+    char ***slot = _NSGetEnviron();
+    char **original = *slot;
+    if (original == NULL) return true;
+
+    size_t count = 0;
+    while (original[count] != NULL) count++;
+
+    char **replacement = calloc(count + 1, sizeof(*replacement));
+    if (replacement == NULL) return false;
+    for (size_t i = 0; i < count; i++) {
+        replacement[i] = strdup(original[i]);
+        if (replacement[i] == NULL) {
+            while (i > 0) free(replacement[--i]);
+            free(replacement);
+            return false;
+        }
+    }
+
+    // Ghostty borrows the original array and its strings. Darwin only
+    // reallocates or frees owned pointers in the current environment. A
+    // separate array and separate strings keep the borrowed data readable
+    // for the lifetime of the library.
+    *slot = replacement;
+    return true;
+}
diff --git a/Sources/GhosttyHostEnvironment/include/GhosttyHostEnvironment.h b/Sources/GhosttyHostEnvironment/include/GhosttyHostEnvironment.h
new file mode 100644
index 0000000..313d3cd
--- /dev/null
+++ b/Sources/GhosttyHostEnvironment/include/GhosttyHostEnvironment.h
@@ -0,0 +1,10 @@
+#ifndef GHOSTTY_HOST_ENVIRONMENT_H
+#define GHOSTTY_HOST_ENVIRONMENT_H
+
+#include <stdbool.h>
+
+/// After Ghostty initializes, give libc a separate environment to mutate.
+/// Run once during startup, before starting work that may change the environment.
+bool ghostty_host_detach_environment(void);
+
+#endif
